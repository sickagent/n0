# n0 local/development configuration.
# Copy to .env. Never reuse these development credentials in production.

ENVIRONMENT=development
LOG_LEVEL=info

# Infrastructure (Docker Compose service addresses)
NATS_URL=nats://nats:4222
POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/meta?sslmode=disable
REDIS_ADDR=redis:6379

# Insecure development-only keys. Generate independent production keys with:
# openssl rand -base64 32
JWT_SECRET=bjAtZGV2ZWxvcG1lbnQtand0LWtleS0zMi1ieXRlcyE=
ENCRYPTION_KEY=bjAtZGV2ZWxvcG1lbnQtYWVzLWtleS0zMi1ieXRlcyE=
JWT_EXPIRY_HOURS=8
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Internal gRPC discovery fallbacks
META_SERVICE_ADDR=meta-service:8080
META_SERVICE_HTTP_URL=http://meta-service:8081
QUERY_ENGINE_ADDR=query-engine:8080
CONNECTION_MANAGER_ADDR=connection-manager:8080

# Optional Vault endpoint for development. Production credentials must come
# from the orchestrator secret store, not from an env file.
VAULT_ADDR=http://vault:8200
